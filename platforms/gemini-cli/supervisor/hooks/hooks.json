{
  "hooks": {
    "BeforeAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${extensionPath}/scripts/before-agent.mjs\"",
            "timeout": 10000
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${extensionPath}/scripts/after-agent.mjs\"",
            "timeout": 20000
          }
        ]
      }
    ]
  }
}
